# Copiar a .env y completar. Nunca subir .env al repositorio.
HEALTHRAG_ENV=development

# Ruta alternativa de configuración (opcional)
# HEALTHRAG_CONFIG=config.yaml

# Proveedor LLM compatible con la API de OpenAI (OpenAI, Groq, Ollama...)
# Para Ollama local: HEALTHRAG_LLM_PROVIDER=openai_compatible,
#   HEALTHRAG_LLM_BASE_URL=http://localhost:11434/v1, OPENAI_API_KEY=ollama
# HEALTHRAG_LLM_PROVIDER=openai_compatible
# HEALTHRAG_LLM_BASE_URL=
# HEALTHRAG_ANALYST_MODEL=gpt-4o-mini
# HEALTHRAG_VERIFIER_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Claves aceptadas por la API (separadas por coma) si require_api_key=true
# HEALTHRAG_API_KEYS=clave-demo-1,clave-demo-2

# Webhook opcional para la acción automática
# HEALTHRAG_WEBHOOK_URL=

# Token de Hugging Face (solo si un modelo lo requiere)
# HUGGINGFACEHUB_API_TOKEN=
